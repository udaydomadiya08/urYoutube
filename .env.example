# urYouTube v3.3.1 — Optional Server-Side Configuration (.env)
# Copy this file to `.env` when running `node server.js` so API keys remain 100% server-side.
# Leave keys blank or use placeholders to run in local-first / public-mirror mode.
PORT=3000
HOST=127.0.0.1
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
GEMINI_API_KEY=your_gemini_api_key_here
